{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warpgogol.com/schemas/projektarchiv/tenant.schema.json",
  "title": "TenantV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tenantId", "displayName", "status", "createdAt"],
  "properties": {
    "schema": {
      "const": "projektarchiv.tenant@1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["active", "suspended", "closed"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
