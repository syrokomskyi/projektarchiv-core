{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warpgogol.com/schemas/projektarchiv/legal-hold.schema.json",
  "title": "LegalHoldV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "legalHoldId",
    "tenantId",
    "clientId",
    "targets",
    "status",
    "legalBasis",
    "reason",
    "authorizedBy",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "projektarchiv.legal-hold@1"
    },
    "legalHoldId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": ["active", "released", "expired"]
    },
    "legalBasis": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "authorizedBy": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "releasedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
