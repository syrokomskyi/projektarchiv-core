{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warpgogol.com/schemas/projektarchiv/fact-revision.schema.json",
  "title": "FactRevisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenantId",
    "clientId",
    "projectId",
    "factId",
    "revision",
    "factType",
    "status",
    "value",
    "provenance",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "projektarchiv.fact-revision@1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "factId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "factType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "status": {
      "enum": ["extracted", "reviewed", "accepted", "rejected", "superseded", "proposed_inherited"]
    },
    "value": {},
    "supersedesRevision": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sourceId"],
        "properties": {
          "kind": {
            "enum": [
              "artifact_revision",
              "inherited_fact_revision",
              "operator_assertion",
              "external_authoritative_source"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": ["object", "null"]
          },
          "processorId": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
