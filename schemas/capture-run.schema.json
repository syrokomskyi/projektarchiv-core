{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warpgogol.com/schemas/projektarchiv/capture-run.schema.json",
  "title": "CaptureRunV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "captureRunId",
    "operationId",
    "tenantId",
    "clientId",
    "projectId",
    "workspaceId",
    "state",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "projektarchiv.capture-run@1"
    },
    "captureRunId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "enum": [
        "requested",
        "scanning",
        "capturing",
        "reconciling_changes",
        "committing",
        "committed",
        "retryable_failed",
        "terminal_failed"
      ]
    },
    "expectedPreviousSnapshotId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "committedSnapshotId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
