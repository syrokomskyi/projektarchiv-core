{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warpgogol.com/schemas/projektarchiv/retention-disposition.schema.json",
  "title": "RetentionDispositionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dispositionId",
    "tenantId",
    "clientId",
    "projectId",
    "targetType",
    "targetId",
    "retentionClass",
    "basis",
    "earliestEraseAt",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "projektarchiv.retention-disposition@1"
    },
    "dispositionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targetType": {
      "type": "string",
      "minLength": 1
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "retentionClass": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "earliestEraseAt": {
      "type": "string",
      "format": "date-time"
    },
    "legalHoldId": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
