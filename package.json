{
  "name": "@warpgogol/projektarchiv-core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Portable provider-neutral domain core for Projektarchiv.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrokomskyi/projektarchiv-core.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "default": "./src/ports/index.ts"
    },
    "./policies": {
      "types": "./src/policies/index.ts",
      "default": "./src/policies/index.ts"
    },
    "./schemas-json/*": "./schemas/*.schema.json"
  },
  "files": [
    "dist/",
    "schemas/",
    "src/index.ts",
    "src/identities.ts",
    "src/result.ts",
    "src/policies/",
    "src/ports/",
    "src/schemas/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build:check && pnpm run test",
    "lint": "pnpm exec eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.10.0"
}
